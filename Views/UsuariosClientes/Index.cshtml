@using Microsoft.AspNetCore.Identity
@using PedidoWeb.Modelos
@model IEnumerable<IdentityUser>

@{
    ViewData["Title"] = "Gestão de Acessos";
    var vinculos = ViewBag.Vinculos as List<PedidoWeb.Modelos.UsuarioCliente>;
    var userRoles = ViewBag.UserRoles as Dictionary<string, string>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0">Carteira de Clientes</h2>
        <p class="text-muted small">Defina quais clientes cada login pode visualizar e vender</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle datatable">

                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 border-0">Usuário / Login</th>
                        <th class="py-3 border-0">Perfil / Role</th>
                        <th class="py-3 border-0">Acesso Carteira</th>
                        <th class="py-3 border-0 text-end pe-4">Ação</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var role = userRoles[user.Id];
                        var qtdVinculos = vinculos?.Count(v => v.UsuarioId == user.Id) ?? 0;
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@user.UserName</div>
                                <div class="text-muted small">@user.Email</div>
                            </td>
                            <td>
                                <form asp-action="AtribuirPerfil" method="post" class="d-inline">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <select name="roleName" class="form-select form-select-sm rounded-pill w-auto shadow-sm" onchange="this.form.submit()">
                                        <option value="Nenhum" selected="@(role == "Sem Perfil")">Sem Perfil (Inativo)</option>
                                        <option value="@RolesNomes.Admin" selected="@(role == RolesNomes.Admin)">Administrador</option>
                                        <option value="@RolesNomes.Vendedor" selected="@(role == RolesNomes.Vendedor)">Vendedor</option>
                                    </select>
                                </form>
                            </td>
                            <td>
                                @if (role == RolesNomes.Admin)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                        <i class="bi bi-shield-lock me-1"></i> Acesso Total (Root)
                                    </span>
                                }
                                else if (role == RolesNomes.Vendedor)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">
                                        <i class="bi bi-people me-1"></i> @qtdVinculos Cliente(s)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">
                                        Sem Acesso
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (role == RolesNomes.Vendedor)
                                {
                                    <a asp-action="Gerenciar" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        <i class="bi bi-person-lines-fill me-1"></i> Vincular Clientes
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
