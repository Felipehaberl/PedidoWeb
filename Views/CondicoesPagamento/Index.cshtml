@model IEnumerable<PedidoWeb.Modelos.CondicaoPagamento>
@inject PedidoWeb.Data.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Condições de Pagamento";
    var empresa = DbContext.Empresas.FirstOrDefault();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0">Condições de Pagamento</h2>
        <p class="text-muted small">Configurações de parcelamento para os pedidos</p>
    </div>
    @if (empresa != null && empresa.ModoIntegracao)
    {
        <form asp-action="Importar" method="post">
            <button type="submit" class="btn btn-success shadow-sm px-4 rounded-pill">
                <i class="bi bi-cloud-download me-2"></i> Importar Condições
            </button>
        </form>
    }
    else
    {
        <a asp-action="Criar" class="btn btn-primary shadow-sm px-4 rounded-pill">
            <i class="bi bi-plus-lg me-2"></i> Nova Condição
        </a>
    }
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle datatable">

                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 border-0">Descrição</th>
                        <th class="py-3 border-0">Parcelas</th>
                        <th class="py-3 border-0">Intervalo (Dias)</th>
                        <th class="py-3 border-0 text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@Html.DisplayFor(modelItem => item.Descricao)</td>
                            <td>@Html.DisplayFor(modelItem => item.QuantidadeParcelas)x</td>
                            <td>@item.IntervaloDias dias entre parcelas</td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm rounded-pill overflow-hidden" style="border: 1px solid #dee2e6;">
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-white btn-sm px-3 border-0">
                                        <i class="bi bi-pencil text-primary"></i>
                                    </a>
                                    <a asp-action="Excluir" asp-route-id="@item.Id" class="btn btn-white btn-sm px-3 border-0">
                                        <i class="bi bi-trash text-danger"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
