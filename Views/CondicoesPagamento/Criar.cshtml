@model PedidoWeb.Modelos.CondicaoPagamento

@{
    ViewData["Title"] = "Nova Condição de Pagamento";
    bool modoIntegracao = ViewBag.ModoIntegracao ?? false;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Condições de Pagamento</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nova</li>
        </ol>
    </nav>
    <h2 class="fw-bold text-dark">Cadastrar Condição de Pagamento</h2>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                
                @if (modoIntegracao)
                {
                    <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> 
                        <strong>Modo Integração Ativo:</strong> O cadastro manual está bloqueado. Novas condições devem ser importadas do ERP.
                    </div>
                }

                <form asp-action="Criar">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <fieldset disabled="@(modoIntegracao ? "disabled" : null)">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="Descricao" class="form-label fw-bold small text-uppercase">Descrição</label>
                                <input asp-for="Descricao" class="form-control form-control-lg rounded-3" placeholder="Ex: 30 dias, 30/60/90, à vista" />
                                <span asp-validation-for="Descricao" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="QuantidadeParcelas" class="form-label fw-bold small text-uppercase">Quantidade de Parcelas</label>
                                <input asp-for="QuantidadeParcelas" type="number" class="form-control form-control-lg rounded-3" min="1" value="1" />
                                <span asp-validation-for="QuantidadeParcelas" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="IntervaloDias" class="form-label fw-bold small text-uppercase">Intervalo (Dias)</label>
                                <input asp-for="IntervaloDias" type="number" class="form-control form-control-lg rounded-3" min="0" value="0" />
                                <small class="text-muted">Dias entre o vencimento de cada parcela.</small>
                                <span asp-validation-for="IntervaloDias" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mt-5 pt-3 border-top d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                                <i class="bi bi-check-lg me-2"></i> Salvar Condição
                            </button>
                            <a asp-action="Index" class="btn btn-light btn-lg px-4 rounded-pill border">Cancelar</a>
                        </div>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
