@model PedidoWeb.Modelos.Pedido

@{
    Layout = null;
    ViewData["Title"] = "Impressão de Pedido #" + Model.Id.ToString("D4");
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pedido #@Model.Id.ToString("D4")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        @@media print {
            .no-print { display: none !important; }
            body { background-color: white !important; padding: 0 !important; }
            .card { border: none !important; box-shadow: none !important; }
        }
        body { background-color: #f4f7f6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 40px 0; }
        .print-container { max-width: 850px; margin: 0 auto; background: white; padding: 40px; border-radius: 8px; box-shadow: 0 0 20px rgba(0,0,0,0.05); }
        .invoice-title { color: #1a365d; font-weight: 800; letter-spacing: -1px; }
        .label-gray { color: #7f8c8d; text-transform: uppercase; font-size: 0.75rem; font-weight: 700; }
        .data-value { color: #2c3e50; font-weight: 600; }
        .table thead th { background-color: #f8f9fa; border-bottom: 2px solid #dee2e6; color: #1a365d; text-transform: uppercase; font-size: 0.8rem; }
        .total-box { background-color: #1a365d; color: white; padding: 20px; border-radius: 8px; }
        .header-logo { width: 40px; height: 40px; background: #ff8c2e; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; color: white; font-weight: bold; margin-right: 10px; }
    </style>
</head>
<body>

<div class="no-print container text-center mb-4">
    <button onclick="window.print()" class="btn btn-primary px-4 rounded-pill me-2">
        <i class="bi bi-printer"></i> Imprimir Pedido
    </button>
    <a href="javascript:void(0)" onclick="enviarWhatsApp()" class="btn btn-success px-4 rounded-pill">
        <i class="bi bi-whatsapp"></i> Enviar via WhatsApp
    </a>
</div>

<div class="print-container" id="pedidoContainer">
    <!-- Header -->
    <div class="row mb-5 align-items-center">
        <div class="col-6">
            <div class="d-flex align-items-center mb-2">
                @if (ViewBag.Empresa?.LogomarcaPath != null)
                {
                    <img src="@ViewBag.Empresa.LogomarcaPath" alt="Logo" style="max-height: 60px; margin-right: 15px;" />
                }
                else
                {
                    <div class="header-logo">PW</div>
                }
                <div>
                    <h3 class="invoice-title mb-0">@(ViewBag.Empresa?.NomeFantasia ?? "PedidoWeb")</h3>
                    @if (ViewBag.Empresa != null)
                    {
                        <div class="text-muted small">@ViewBag.Empresa.RazaoSocial</div>
                        <div class="text-muted small">CNPJ: @ViewBag.Empresa.Cnpj</div>
                    }
                </div>
            </div>
            <p class="text-muted small mb-0">Comprovante de Lançamento de Pedido</p>
        </div>
        <div class="col-6 text-end">
            <h4 class="invoice-title">PEDIDO #@Model.Id.ToString("D4")</h4>
            <div class="label-gray">Data de Emissão</div>
            <div class="data-value">@Model.Data.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
    </div>

    <hr class="my-4 text-muted opacity-25">

    <!-- Client & Payment Info -->
    <div class="row mb-5">
        <div class="col-7">
            <div class="label-gray mb-1">Cliente</div>
            <h5 class="data-value mb-1">@Model.Cliente?.Nome</h5>
            <div class="text-muted small">
                CPF/CNPJ: @Model.Cliente?.CpfCnpj<br>
                E-mail: @Model.Cliente?.Email<br>
                Endereço: @Model.Cliente?.Endereco
            </div>
        </div>
        <div class="col-5 text-end">
            <div class="label-gray mb-1">Condição de Pagamento</div>
            <div class="data-value">@Model.CondicaoPagamento?.Descricao</div>
            <div class="text-muted small">@Model.CondicaoPagamento?.QuantidadeParcelas parcela(s)</div>
            
            <div class="mt-3">
                <div class="label-gray mb-1">Status do Pedido</div>
                @switch (Model.Status)
                {
                    case PedidoWeb.Modelos.StatusPedido.Aberto:
                        <span class="badge bg-warning text-dark px-3 mt-1">ABERTO / PENDENTE</span>
                        break;
                    case PedidoWeb.Modelos.StatusPedido.Autorizado:
                        <span class="badge bg-success px-3 mt-1">AUTORIZADO</span>
                        break;
                    default:
                        <span class="badge bg-secondary px-3 mt-1">@Model.Status.ToString().ToUpper()</span>
                        break;
                }
            </div>
        </div>
    </div>

    <!-- Items Table -->
    <div class="table-responsive mb-4">
        <table class="table table-borderless table-striped align-middle">
            <thead>
                <tr>
                    <th class="ps-0">Produto</th>
                    <th class="text-center">Qtd</th>
                    <th class="text-end">Vlr. Unitário</th>
                    <th class="text-end pe-0">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Itens)
                {
                    <tr>
                        <td class="ps-0">
                            <div class="fw-bold text-dark">@item.Produto?.Descricao</div>
                            <div class="text-muted small">Ref: @item.Produto?.Codigo</div>
                        </td>
                        <td class="text-center">@item.Quantidade.ToString("N2")</td>
                        <td class="text-end">@item.ValorUnitario.ToString("C2")</td>
                        <td class="text-end pe-0 fw-bold">@item.ValorTotal.ToString("C2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Summary -->
    <div class="row justify-content-end mt-5">
        <div class="col-md-5">
            <div class="total-box text-center">
                <div class="label-gray text-white-50 mb-1">VALOR TOTAL DO PEDIDO</div>
                <h2 class="mb-0 fw-bold">@Model.ValorTotal.ToString("C2")</h2>
            </div>
        </div>
    </div>

    <div class="mt-5 pt-5 text-center text-muted small border-top">
        <p>Este documento é um resumo de pedido interno e não substitui a Nota Fiscal Eletrônica.</p>
        <p>Gerado em @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</p>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<script>
    function enviarWhatsApp() {
        const tel = "@(Model.Cliente?.Telefone?.Replace("(", "").Replace(")", "").Replace("-", "").Replace(" ", ""))";
        if (!tel) {
            alert("Cliente não possui telefone cadastrado!");
            return;
        }

        let texto = "*PEDIDO #@Model.Id.ToString("D4") - PedidoWeb*\n\n";
        texto += "*Cliente:* @Model.Cliente?.Nome\n";
        texto += "*Data:* @Model.Data.ToString("dd/MM/yyyy")\n";
        texto += "--------------------------------\n";
        
        @foreach (var item in Model.Itens)
        {
            <text>texto += "• @item.Produto?.Descricao - @item.Quantidade.ToString("N0") x @item.ValorUnitario.ToString("C2")\n";</text>
        }
        
        texto += "--------------------------------\n";
        texto += "*VALOR TOTAL: @Model.ValorTotal.ToString("C2")*\n\n";
        texto += "Obrigado pela preferência!";

        const encodedText = encodeURIComponent(texto);
        const url = `https://wa.me/55${tel}?text=${encodedText}`;
        window.open(url, '_blank');
    }
</script>

</body>
</html>
