@model PedidoWeb.Modelos.Pedido

@{
    ViewData["Title"] = "Detalhes do Pedido #" + Model.Id.ToString("D4");
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Pedidos</a></li>
                <li class="breadcrumb-item active" aria-current="page">Pedido #@Model.Id.ToString("D4")</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-dark">Pedido #@Model.Id.ToString("D4")</h2>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status == PedidoWeb.Modelos.StatusPedido.Aberto)
        {
            <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary shadow-sm px-4 rounded-pill">
                <i class="bi bi-pencil me-2"></i> Editar
            </a>
            
            <form asp-action="Autorizar" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-success shadow-sm px-4 rounded-pill">
                    <i class="bi bi-check-circle me-2"></i> Autorizar
                </button>
            </form>
        }
        <a asp-action="Imprimir" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-dark shadow-sm px-4 rounded-pill">
            <i class="bi bi-printer me-2"></i> Imprimir
        </a>
        <a href="javascript:void(0)" onclick="enviarWhatsApp()" class="btn btn-success shadow-sm px-4 rounded-pill">
            <i class="bi bi-whatsapp me-2"></i> WhatsApp
        </a>
    </div>
</div>

<script>
    function enviarWhatsApp() {
        const tel = "@(Model.Cliente?.Telefone?.Replace("(", "").Replace(")", "").Replace("-", "").Replace(" ", ""))";
        if (!tel) {
            alert("Cliente não possui telefone cadastrado!");
            return;
        }

        let texto = "*PEDIDO #@Model.Id.ToString("D4") - PedidoWeb*\n\n";
        texto += "*Cliente:* @Model.Cliente?.Nome\n";
        texto += "*Data:* @Model.Data.ToString("dd/MM/yyyy")\n";
        texto += "--------------------------------\n";
        
        @foreach (var item in Model.Itens)
        {
            <text>texto += "• @item.Produto?.Descricao - @item.Quantidade.ToString("N0") x @item.ValorUnitario.ToString("C2")\n";</text>
        }
        
        texto += "--------------------------------\n";
        texto += "*VALOR TOTAL: @Model.ValorTotal.ToString("C2")*\n\n";
        texto += "Visualizar online: " + window.location.href;

        const encodedText = encodeURIComponent(texto);
        const url = `https://wa.me/55${tel}?text=${encodedText}`;
        window.open(url, '_blank');
    }
</script>


<div class="row">
    <div class="col-12">
        <!-- Card 1: Cabeçalho do Pedido -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-4 border-end">
                        <h6 class="text-muted small text-uppercase fw-bold mb-3"><i class="bi bi-person me-2"></i>Informações do Cliente</h6>
                        <h5 class="fw-bold mb-1">@Model.Cliente?.Nome</h5>
                        <p class="text-muted small mb-0">CPF/CNPJ: @Model.Cliente?.CpfCnpj</p>
                        <p class="text-muted small mb-0"><i class="bi bi-geo-alt me-1"></i> @Model.Cliente?.Endereco</p>
                    </div>
                    <div class="col-md-4 border-end ps-md-4">
                        <h6 class="text-muted small text-uppercase fw-bold mb-3"><i class="bi bi-credit-card me-2"></i>Pagamento e Status</h6>
                        <p class="mb-1 text-dark fw-semibold">@Model.CondicaoPagamento?.Descricao</p>
                        <p class="text-muted small mb-2">@Model.CondicaoPagamento?.QuantidadeParcelas parcela(s)</p>
                        <span class="badge @(Model.Status == PedidoWeb.Modelos.StatusPedido.Autorizado ? "bg-success" : "bg-warning") bg-opacity-10 @(Model.Status == PedidoWeb.Modelos.StatusPedido.Autorizado ? "text-success" : "text-warning") fs-6 px-4 py-2 rounded-pill">
                             <i class="bi bi-circle-fill me-1 small"></i> @Model.Status
                        </span>
                    </div>
                    <div class="col-md-4 text-center">
                        <h6 class="text-muted small text-uppercase fw-bold mb-2">Total do Pedido</h6>
                        <h1 class="fw-bold text-primary mb-0" style="font-size: 2.5rem;">@Model.ValorTotal.ToString("C2")</h1>
                        <p class="text-muted small mb-0">Data: @Model.Data.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Itens do Pedido -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-0 ps-4">
                <h5 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2 text-primary"></i>Produtos Selecionados</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Item</th>
                                <th>Produto</th>
                                <th class="text-center">Quantidade</th>
                                <th class="text-end">Vlr. Unitário</th>
                                <th class="pe-4 text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int n = 1; }
                            @foreach (var item in Model.Itens)
                            {
                                <tr>
                                    <td class="ps-4 text-muted small">#@n</td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Produto?.Descricao</div>
                                        <div class="text-muted small" style="font-size: 0.75rem;">
                                            Cód: @item.Produto?.Codigo | ERP: @(item.Produto?.ProdutoIdIntegracao ?? "-")
                                        </div>
                                    </td>
                                    <td class="text-center fw-semibold">@item.Quantidade.ToString("N2")</td>
                                    <td class="text-end">@item.ValorUnitario.ToString("C2")</td>
                                    <td class="pe-4 text-end fw-bold text-dark">@item.ValorTotal.ToString("C2")</td>
                                </tr>
                                n++;
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end fw-bold py-3">Resumo Total:</td>
                                <td class="pe-4 text-end fw-bold text-primary py-3">@Model.ValorTotal.ToString("C2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

