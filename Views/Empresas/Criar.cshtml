@model PedidoWeb.Modelos.Empresa

@{
    ViewData["Title"] = "Configurar Empresa";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Empresa</a></li>
            <li class="breadcrumb-item active" aria-current="page">Configurar</li>
        </ol>
    </nav>
    <h2 class="fw-bold text-dark">Configurar Dados da Empresa</h2>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Criar" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Cnpj" class="form-label fw-bold small text-uppercase">CNPJ</label>
                            <input asp-for="Cnpj" class="form-control form-control-lg rounded-3" placeholder="00.000.000/0000-00" />
                            <span asp-validation-for="Cnpj" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="RazaoSocial" class="form-label fw-bold small text-uppercase">Razão Social</label>
                            <input asp-for="RazaoSocial" class="form-control form-control-lg rounded-3" />
                            <span asp-validation-for="RazaoSocial" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="NomeFantasia" class="form-label fw-bold small text-uppercase">Nome Fantasia</label>
                            <input asp-for="NomeFantasia" class="form-control form-control-lg rounded-3" />
                            <span asp-validation-for="NomeFantasia" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-uppercase">Logomarca</label>
                            <div class="input-group">
                                <input type="file" name="logoFile" class="form-control rounded-3" accept="image/*" />
                            </div>
                            <div class="form-text mt-2 small">Formatos recomendados: PNG ou JPG com fundo transparente.</div>
                        </div>

                        <div class="col-md-12 mt-4">
                            <div class="form-check form-switch bg-light p-3 rounded-4 ps-5">
                                <input class="form-check-input" type="checkbox" asp-for="ModoIntegracao" id="switchIntegracao" style="margin-left: -2.5em; width: 3em; height: 1.5em;">
                                <label class="form-check-label fw-bold ms-2 mt-1" asp-for="ModoIntegracao">
                                    Ativar Modo Integração
                                </label>
                                <div class="text-muted small ms-2">Ative esta flag para habilitar comunicações automáticas com o ERP (WebService).</div>
                            </div>
                        </div>

                        <div class="col-md-12 mt-3" id="divWebService" style="display: none;">
                            <label asp-for="WebServiceUrl" class="form-label fw-bold small text-uppercase">Endereço (URL) do WebService</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-link-45deg"></i></span>
                                <input asp-for="WebServiceUrl" class="form-control form-control-lg rounded-end-3" placeholder="https://cliente.servidor.com.br/api/wsdl" />
                            </div>
                            <span asp-validation-for="WebServiceUrl" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-5 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                            <i class="bi bi-check-lg me-2"></i> Salvar Configuração
                        </button>
                        <a asp-action="Index" class="btn btn-light btn-lg px-4 rounded-pill border">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            function toggleWebService() {
                if ($('#switchIntegracao').is(':checked')) {
                    $('#divWebService').slideDown();
                } else {
                    $('#divWebService').slideUp();
                }
            }

            $('#switchIntegracao').on('change', toggleWebService);
            toggleWebService(); // Executa ao carregar
        });
    </script>
}
