@model IEnumerable<PedidoWeb.Modelos.Empresa>

@{
    ViewData["Title"] = "Gestão da Empresa";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0">Configuração da Empresa</h2>
        <p class="text-muted">Dados da empresa para relatórios e identidade visual.</p>
    </div>
    @if (!Model.Any())
    {
        <a asp-action="Criar" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-2"></i> Configurar Empresa
        </a>
    }
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4" width="100">Logo</th>
                        <th>CNPJ / Razão Social</th>
                        <th>Nome Fantasia</th>
                        <th class="text-center">Integração</th>
                        <th class="pe-4 text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                @if (!string.IsNullOrEmpty(item.LogomarcaPath))
                                {
                                    <img src="@item.LogomarcaPath" alt="Logo" class="rounded shadow-sm" style="max-height: 50px; max-width: 80px; object-fit: contain;" />
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 50px; width: 80px;">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.RazaoSocial</div>
                                <div class="text-muted small">@item.Cnpj</div>
                            </td>
                            <td>@item.NomeFantasia</td>
                            <td class="text-center">
                                @if (item.ModoIntegracao)
                                {
                                    <span class="badge bg-success-subtle text-success rounded-pill px-3">Ativo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">Inativo</span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    <i class="bi bi-pencil-square me-1"></i> Editar
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-building-exclamation display-4 d-block mb-3"></i>
                                Nenhuma empresa configurada. Clique em "Configurar Empresa" para começar.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
