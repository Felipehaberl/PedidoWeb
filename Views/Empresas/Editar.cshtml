@model PedidoWeb.Modelos.Empresa

@{
    ViewData["Title"] = "Editar Empresa";
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Empresa</a></li>
            <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
    </nav>
    <h2 class="fw-bold text-dark">Editar Dados da Empresa</h2>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Editar" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="LogomarcaPath" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <ul class="nav nav-tabs mb-4" id="empresaTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="dados-tab" data-bs-toggle="tab" data-bs-target="#dados" type="button" role="tab" aria-controls="dados" aria-selected="true">Dados Gerais</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="params-tab" data-bs-toggle="tab" data-bs-target="#params" type="button" role="tab" aria-controls="params" aria-selected="false">Parâmetros</button>
                        </li>
                    </ul>

                    <div class="tab-content" id="myTabContent">
                        <!-- Aba Dados Gerais -->
                        <div class="tab-pane fade show active" id="dados" role="tabpanel" aria-labelledby="dados-tab">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Cnpj" class="form-label fw-bold small text-uppercase">CNPJ</label>
                                    <input asp-for="Cnpj" class="form-control form-control-lg rounded-3" />
                                    <span asp-validation-for="Cnpj" class="text-danger small"></span>
                                </div>

                                <div class="col-md-12">
                                    <label asp-for="RazaoSocial" class="form-label fw-bold small text-uppercase">Razão Social</label>
                                    <input asp-for="RazaoSocial" class="form-control form-control-lg rounded-3" />
                                    <span asp-validation-for="RazaoSocial" class="text-danger small"></span>
                                </div>

                                <div class="col-md-12">
                                    <label asp-for="NomeFantasia" class="form-label fw-bold small text-uppercase">Nome Fantasia</label>
                                    <input asp-for="NomeFantasia" class="form-control form-control-lg rounded-3" />
                                    <span asp-validation-for="NomeFantasia" class="text-danger small"></span>
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label fw-bold small text-uppercase">Logomarca Atual</label>
                                    <div class="mb-3 d-flex align-items-center gap-3 p-3 bg-light rounded-4">
                                        @if (!string.IsNullOrEmpty(Model.LogomarcaPath))
                                        {
                                            <img src="@Model.LogomarcaPath" alt="Logo" class="rounded shadow-sm" style="max-height: 80px;" />
                                            <div>
                                                <p class="mb-0 small fw-bold">Alterar Logomarca</p>
                                                <input type="file" name="logoFile" class="form-control form-control-sm mt-1" accept="image/*" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="bg-white rounded d-flex align-items-center justify-content-center border" style="height: 80px; width: 120px;">
                                                <i class="bi bi-image text-muted display-6"></i>
                                            </div>
                                            <div>
                                                <p class="mb-0 small fw-bold">Fazer Upload de Logo</p>
                                                <input type="file" name="logoFile" class="form-control form-control-sm mt-1" accept="image/*" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Aba Parâmetros -->
                        <div class="tab-pane fade" id="params" role="tabpanel" aria-labelledby="params-tab">
                            <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4">
                                <i class="bi bi-info-circle-fill me-2"></i> Configurações globais do sistema e integrações.
                            </div>

                            <div class="row g-4">
                                <div class="col-12">
                                    <h6 class="fw-bold text-uppercase text-muted border-bottom pb-2 mb-3">Controle de Estoque</h6>
                                    <div class="form-check form-switch ps-5">
                                        <input class="form-check-input" type="checkbox" asp-for="ValidarEstoque" id="switchEstoque" style="margin-left: -2.5em; width: 3em; height: 1.5em;">
                                        <label class="form-check-label fw-bold ms-2 mt-1" asp-for="ValidarEstoque">
                                            Validar Estoque ao Criar Pedido
                                        </label>
                                        <div class="text-muted small ms-2">Se marcado, impede a venda de itens com saldo insuficiente.</div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <h6 class="fw-bold text-uppercase text-muted border-bottom pb-2 mb-3">Integração ERP (C&S)</h6>
                                    <div class="form-check form-switch ps-5 mb-3 bg-light p-3 rounded-4">
                                        <input class="form-check-input" type="checkbox" asp-for="ModoIntegracao" id="switchIntegracao" style="margin-left: -2.5em; width: 3em; height: 1.5em;">
                                        <label class="form-check-label fw-bold ms-2 mt-1" asp-for="ModoIntegracao">
                                            Ativar Modo Integração
                                        </label>
                                        <div class="text-muted small ms-2">Habilita importação/exportação automática e bloqueia cadastros manuais.</div>
                                    </div>

                                    <div id="divWebService" style="display: none;">
                                        <label asp-for="WebServiceUrl" class="form-label fw-bold small text-uppercase">Endereço (URL) do WebService</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light"><i class="bi bi-link-45deg"></i></span>
                                            <input asp-for="WebServiceUrl" class="form-control form-control-lg rounded-end-3" placeholder="https://cliente.servidor.com.br/api/wsdl" />
                                        </div>
                                        <span asp-validation-for="WebServiceUrl" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                            <i class="bi bi-save me-2"></i> Salvar Alterações
                        </button>
                        <a asp-action="Index" class="btn btn-light btn-lg px-4 rounded-pill border">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            function toggleWebService() {
                if ($('#switchIntegracao').is(':checked')) {
                    $('#divWebService').slideDown();
                } else {
                    $('#divWebService').slideUp();
                }
            }

            $('#switchIntegracao').on('change', toggleWebService);
            toggleWebService(); // Executa ao carregar
        });
    </script>
}
