@model PedidoWeb.Modelos.Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="mb-4 text-center">
    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
        <i class="bi bi-box-fill fs-2"></i>
    </div>
    <h2 class="fw-bold text-dark">Remover Produto?</h2>
    <p class="text-muted">Você está prestes a remover o produto do catálogo.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="bg-light p-4 text-center border-bottom">
                <span class="text-primary small fw-bold">SKU: @Model.Codigo</span>
                <h4 class="fw-bold text-dark mt-1">@Model.Descricao</h4>
            </div>
            <div class="card-body p-4">
                <div class="row text-center mb-4">
                    <div class="col-6 border-end">
                        <label class="d-block text-muted small text-uppercase">Preço</label>
                        <span class="fw-bold">@Model.Preco.ToString("C2")</span>
                    </div>
                    <div class="col-6">
                        <label class="d-block text-muted small text-uppercase">Estoque</label>
                        <span class="fw-bold">@Model.Estoque.ToString("N2")</span>
                    </div>
                </div>
                
                <form asp-action="Excluir" class="d-grid gap-2">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger btn-lg rounded-pill shadow-sm">Confirmar Remoção</button>
                    <a asp-action="Index" class="btn btn-light btn-lg rounded-pill border">Desistir</a>
                </form>
            </div>
        </div>
    </div>
</div>
