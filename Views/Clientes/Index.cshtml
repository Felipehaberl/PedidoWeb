@model IEnumerable<PedidoWeb.Modelos.Cliente>
@inject PedidoWeb.Data.ApplicationDbContext DbContext
@{
    ViewData["Title"] = "Clientes";
    var empresa = DbContext.Empresas.FirstOrDefault();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0">Clientes</h2>
        <p class="text-muted small">Gerenciamento da base de clientes do sistema</p>
    </div>
    @if (empresa != null && empresa.ModoIntegracao)
    {
        <form asp-action="Importar" method="post">
            <button type="submit" class="btn btn-success shadow-sm px-4 rounded-pill">
                <i class="bi bi-cloud-download me-2"></i> Importar Clientes
            </button>
        </form>
    }
    else
    {
        <a asp-action="Criar" class="btn btn-primary shadow-sm px-4 rounded-pill">
            <i class="bi bi-plus-lg me-2"></i> Novo Cliente
        </a>
    }
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle datatable">

                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 border-0">@Html.DisplayNameFor(model => model.Nome)</th>
                        <th class="py-3 border-0">CPF/CNPJ</th>
                        <th class="py-3 border-0">E-mail</th>
                        <th class="py-3 border-0 text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">@Html.DisplayFor(modelItem => item.Nome)</td>
                            <td>@Html.DisplayFor(modelItem => item.CpfCnpj)</td>
                            <td>@Html.DisplayFor(modelItem => item.Email)</td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm rounded-pill overflow-hidden" style="border: 1px solid #dee2e6;">
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-white btn-sm px-3 border-0" title="Editar">
                                        <i class="bi bi-pencil text-primary"></i>
                                    </a>
                                    <a asp-action="Detalhes" asp-route-id="@item.Id" class="btn btn-white btn-sm px-3 border-0" title="Detalhes">
                                        <i class="bi bi-info-circle text-info"></i>
                                    </a>
                                    <a asp-action="Excluir" asp-route-id="@item.Id" class="btn btn-white btn-sm px-3 border-0" title="Excluir">
                                        <i class="bi bi-trash text-danger"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-people text-muted opacity-25" style="font-size: 5rem;"></i>
        <p class="text-muted mt-3">Nenhum cliente cadastrado ainda.</p>
        <a asp-action="Criar" class="btn btn-outline-primary btn-sm rounded-pill mt-2">Cadastrar o primeiro</a>
    </div>
}
